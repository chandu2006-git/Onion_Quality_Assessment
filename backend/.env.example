# ---------------------------------------------------------------------------
# ONION DETECT backend configuration
# Copy to .env and adjust. Never commit real .env files.
# ---------------------------------------------------------------------------

# --- Trained model files --------------------------------------------------
# Paths are resolved relative to the backend/ directory when not absolute.
MODEL_DETECTOR_PATH=models/onion_detector_v1.pt
MODEL_HEALTH_CLASSIFIER_PATH=models/onion_health_mobilenetv2_best.keras

# Class represented by the single sigmoid output value of the health model.
# TensorFlow directory-order training ("healthy" < "unhealthy") makes the single
# unit estimate Unhealthy. Set to "Healthy" if your model was built the other way.
CLASSIFIER_POSITIVE_CLASS=Unhealthy

# --- Server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Comma separated list of allowed frontend origins. Entries containing "*" are
# compiled into an origin regex so any local development port works
# (Flutter Web assigns its port dynamically). Production: list exact origins
# only, and never combine "*" with enabled credentials.
CORS_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*,http://localhost:8080,http://localhost:3000

# --- Upload / inference ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
CONFIDENCE_THRESHOLD=0.25
MAX_INFERENCE_SIDE=1600
